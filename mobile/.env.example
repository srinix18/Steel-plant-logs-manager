# Physical phone: use your PC Wi-Fi LAN IP (not localhost).
# Example: EXPO_PUBLIC_API_URL=http://10.119.123.130:8000/api/v1
# Print IPs: powershell -File ../scripts/print-lan-ip.ps1
# Emulator can use: http://10.0.2.2:8000/api/v1 (Android emulator → host loopback)

EXPO_PUBLIC_API_URL=http://10.119.123.130:8000/api/v1
