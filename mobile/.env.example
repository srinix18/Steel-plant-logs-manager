# Physical phone: use your PC Wi-Fi LAN IP (not localhost).
# Print IPs: powershell -File ../scripts/print-lan-ip.ps1
# Emulator (Android): http://10.0.2.2:8000/api/v1
#
# Local Expo Go / Metro (replace with your current Wi-Fi IPv4):
EXPO_PUBLIC_API_URL=http://192.168.0.168:8000/api/v1

# --- EAS builds (P6-EAS) ---
# Set per-profile in eas.json → build.<profile>.env.EXPO_PUBLIC_API_URL
# or override at build time:
#   eas build -p android --profile preview --env EXPO_PUBLIC_API_URL=https://staging.example.com/api/v1
#   eas build -p android --profile production --env EXPO_PUBLIC_API_URL=https://api.example.com/api/v1
#
# Staging (HTTPS recommended):
# EXPO_PUBLIC_API_URL=https://staging.example.com/api/v1
# Production (HTTPS required for store builds):
# EXPO_PUBLIC_API_URL=https://api.example.com/api/v1
