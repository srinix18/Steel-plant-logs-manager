# Backend
# Port 5433 avoids conflict with native/WSL Postgres on 5432 (use docker compose up postgres -d)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/moi_platform
JWT_SECRET_KEY=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SEED_ADMIN_EMAIL=admin@logbook.app
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=System Admin

# Frontend
VITE_API_URL=http://localhost:8000/api/v1
