# Backend
# Port 5433 avoids conflict with native/WSL Postgres on 5432 (use docker compose up postgres -d)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/moi_platform
JWT_SECRET_KEY=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8081,http://localhost:19006,http://127.0.0.1:8081
SEED_ADMIN_EMAIL=admin@logbook.app
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=System Admin

# Frontend — for PWA / phone clients use public HTTPS API (not localhost)
VITE_API_URL=http://localhost:8000/api/v1

# Mobile (Expo) — set after P1-01; on a physical phone use LAN IP, not localhost
# EXPO_PUBLIC_API_URL=http://192.168.x.x:8000/api/v1
# See docs/MOBILE_P1_00_PREREQUISITES.md
